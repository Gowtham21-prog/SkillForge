# Copy to .env (or set these as real environment variables / secrets in your deploy platform).
# This file documents every configurable value — never commit actual secrets.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/elearning_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=changeme
DB_POOL_SIZE=10

# --- Hibernate ---
# Use "validate" in production once your schema is stable; "update" is fine for dev.
DDL_AUTO=update
SHOW_SQL=false

# --- Server ---
SERVER_PORT=8080

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- File uploads ---
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=20MB
UPLOAD_DIR=uploads

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Mail (password reset / verification emails) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@learnhub.local
FRONTEND_BASE_URL=http://localhost:3000

# --- Stripe ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_REGISTER=3
RATE_LIMIT_REGISTER_WINDOW=60

# --- Logging ---
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_APP=INFO
